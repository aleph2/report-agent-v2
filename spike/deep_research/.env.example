# Model settings for the OpenAI-compatible Bailian API.
MODEL_NAME=deepseek-v4.1-flash-1017
# Beijing workspace endpoint; replace YOUR_WORKSPACE_ID with your workspace ID.
OPENAI_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=

# Required for the example's web search.
TAVILY_API_KEY=

# Used by the LangGraph local server.
LANGSMITH_API_KEY=
